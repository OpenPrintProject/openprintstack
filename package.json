{
  "name": "open-print-stack",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @openprintstack/server --filter @openprintstack/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "pnpm --filter @openprintstack/server start",
    "test": "vitest run",
    "test:smoke": "pnpm -r --if-present test:smoke",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
